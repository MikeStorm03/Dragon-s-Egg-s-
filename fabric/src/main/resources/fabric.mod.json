{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "Unlimited Dragon Eggs and add \"generation\" block state to keep track of it.",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "https://github.com/MikeStorm03/Dragon-s-Egg-s-",
        "sources": "https://modrinth.com/mod/dragons-egg(s)"
    },
    "license": "${license}",
    "icon": "assets/${mod_id}.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.msg.DragonsEggSFabric"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json",
        "${mod_id}.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": "~${minecraft_version}",
        "java": ">=${java_version}",
		"ferritecore": "*"
	},
	"breaks" : {
		"infinite-dragon-eggs": "*"
	}
}
  